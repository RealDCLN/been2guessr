# Web app limits and rate limiting
MAX_CONCURRENT_JOBS=2
MAX_BUILD_LOCATIONS=2000
JOB_TTL_SECONDS=3600
RATE_LIMIT_JOBS=5
RATE_LIMIT_WINDOW=3600

# Set to true only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

# Optional: comma-separated CORS origins if you call the API from another site.
# ALLOWED_ORIGINS=https://example.com
